{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run C++",
            "type": "shell",
            "command": "g++ -std=c++17 \"${file}\" -o \"/tmp/dsa_solution\" && \"/tmp/dsa_solution\" < \"${workspaceFolder}/input.txt\" > \"${workspaceFolder}/output.txt\"",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}